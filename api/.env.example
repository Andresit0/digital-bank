# Digital Bank API - example environment variables
# Copy to ".env" and adjust for your environment.

# Runtime
STAGE=dev
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_bank
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication
JWT_SECRET=llaveSecretaDigitalBank
JWT_EXPIRES_IN=2h

# Seed (dev only). Set to "false" to disable the seed of examples (reset + reload) on startup.
SEED_ON_START=true
